---
import terminal from '../data/terminal.json';
import roles from '../data/roles.json';
import experience from '../data/experience.json';
import projects from '../data/projects.json';
import stack from '../data/stack.json';
import postgresStats from '../data/postgres-stats.json';
import profile from '../data/profile.json';

const data = { terminal, roles, experience, projects, stack, postgresStats, links: profile.links };
---

<section class="terminal" aria-label="Interactive psql session" data-terminal>
  <header class="terminal__header">
    <div><span class="terminal__cursor">▌</span> <span class="terminal__accent">swebber</span>.me — psql 8.0.26</div>
  </header>

  <div class="terminal__output" data-output aria-live="polite">
    <div class="terminal__intro">
      {terminal.intro.map((line) => <div>{line || <br />}</div>)}
    </div>
    <div data-results></div>
    <div class="terminal__prompt"><span>seba=#</span> <span data-typing></span><i aria-hidden="true"></i></div>
  </div>

  <footer class="terminal__footer">
    <span>run:</span>
    <div class="terminal__commands" data-commands></div>
    <label class="terminal__autoplay"><input type="checkbox" data-autoplay checked /> autoplay terminal session</label>
  </footer>
</section>

<script is:inline define:vars={{ data }}>
  const root = document.querySelector('[data-terminal]');
  const output = root.querySelector('[data-output]');
  const results = root.querySelector('[data-results]');
  const typing = root.querySelector('[data-typing]');
  const commands = root.querySelector('[data-commands]');
  const autoplay = root.querySelector('[data-autoplay]');
  const preference = 'swebber:terminal-autoplay';
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let cancelled = false;
  let hasStarted = false;

  try { autoplay.checked = localStorage.getItem(preference) !== 'off'; } catch { /* storage is optional */ }
  if (reducedMotion) autoplay.checked = false;

  const wait = (ms) => new Promise((resolve) => window.setTimeout(resolve, ms));
  const esc = (value) => String(value).replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character]);
  const scroll = () => { output.scrollTop = output.scrollHeight; };

  const table = (headers, rows) => `<div class="terminal-table terminal-table--${headers.length}"><div class="terminal-table__head">${headers.map(esc).map((value) => `<div>${value}</div>`).join('')}</div>${rows.map((row) => `<div class="terminal-table__row">${row.map((value, index) => `<div${index === 0 ? ' class="terminal-table__accent"' : ''}>${esc(value)}</div>`).join('')}</div>`).join('')}</div>`;
  const cards = (items) => `<div class="terminal-cards">${items.map((item) => `<article class="blueprint"><i class="corner corner--tl"></i><i class="corner corner--tr"></i><i class="corner corner--bl"></i><i class="corner corner--br"></i><strong>${esc(item.name)}</strong><p>${esc(item.attrs)}</p><p>${esc(item.desc)}</p></article>`).join('')}</div>`;

  function response(step) {
    if (step.kind === 'text') return step.lines.map((line) => `<div>${esc(line)}</div>`).join('');
    if (step.kind === 'postgresStats') return table(['since', 'postgres_version'], data.postgresStats.map((item) => [item.since, item.postgres_version]));
    if (step.kind === 'roles') return cards(data.roles);
    if (step.kind === 'experience') return table(['where', 'what', 'when'], data.experience.map((item) => [item.where, item.what, item.when]));
    if (step.kind === 'projects') return table(['name', 'what it does', 'status'], data.projects.map((item) => [item.name, item.what, item.status]));
    if (step.kind === 'stack') return table(['area', 'tools', ''], data.stack.map((item) => [item.area, item.tools, '']));
    return `<div class="terminal-links">${data.links.map((link) => `<div><span>${esc(link.label)}</span><a href="${esc(link.href)}">${esc(link.value)}</a></div>`).join('')}</div>`;
  }

  function append(step) {
    results.insertAdjacentHTML('beforeend', `<section class="terminal-result"><div class="terminal-result__command"><span>seba=#</span> ${esc(step.cmd)}</div><div class="terminal-result__body">${response(step)}</div><div class="terminal-result__footer">${esc(step.footer)}</div></section>`);
    scroll();
  }

  async function replay() {
    hasStarted = true;
    cancelled = false;
    await wait(700);
    for (const step of data.terminal.steps) {
      if (cancelled) return;
      for (let index = 1; index <= step.cmd.length; index += 1) {
        if (cancelled) return;
        typing.textContent = step.cmd.slice(0, index);
        await wait(34 + Math.random() * 20);
      }
      await wait(340);
      append(step);
      typing.textContent = '';
      await wait(1100);
    }
  }

  for (const step of data.terminal.steps) {
    const button = document.createElement('button');
    button.type = 'button';
    button.textContent = step.label;
    button.addEventListener('click', () => { cancelled = true; typing.textContent = ''; append(step); });
    commands.append(button);
  }

  autoplay.addEventListener('change', () => {
    try { localStorage.setItem(preference, autoplay.checked ? 'on' : 'off'); } catch { /* storage is optional */ }
    if (!autoplay.checked) cancelled = true;
    if (autoplay.checked && !hasStarted) replay();
  });

  if (autoplay.checked) replay();
</script>
