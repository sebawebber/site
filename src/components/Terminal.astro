---
import terminal from '../data/terminal.json';
import extensions from '../data/extensions.json';
import experience from '../data/experience.json';
import projects from '../data/projects.json';
import stack from '../data/stack.json';
import postgresStats from '../data/postgres-stats.json';
import profile from '../data/profile.json';
---

<section class="terminal" aria-label="psql session">
  <header class="terminal__header">
    <div class="terminal__shell-prompt"><span class="terminal__shell-path">~/swebber.me</span><span class="terminal__shell-home">~</span><span class="terminal__shell-mark" aria-hidden="true"><i></i><i></i><i></i></span><span>psql</span></div>
  </header>

  <div class="terminal__output">
    <div class="terminal__intro">
      {terminal.intro.map((line) => <div>{line || <br />}</div>)}
    </div>

    {terminal.steps.map((step) => (
      <section class="terminal-result">
        <div class="terminal-result__command"><span>seba=#</span> {step.cmd}</div>
        <div class="terminal-result__body">
          {step.kind === 'postgresStats' && (
            <div class="terminal-table terminal-table--2">
              <div class="terminal-table__head"><div>since</div><div>postgres_version</div></div>
              {postgresStats.map((item) => <div class="terminal-table__row"><div class="terminal-table__accent">{item.since}</div><div>{item.postgres_version}</div></div>)}
            </div>
          )}
          {step.kind === 'extensions' && (
            <div class="terminal-cards">
              {extensions.map((item) => <article class="blueprint"><i class="corner corner--tl"></i><i class="corner corner--tr"></i><i class="corner corner--bl"></i><i class="corner corner--br"></i><strong>{item.name}</strong><p>{item.attrs}</p><p>{item.desc}</p></article>)}
            </div>
          )}
          {step.kind === 'experience' && (
            <div class="terminal-table">
              <div class="terminal-table__head"><div>where</div><div>what</div><div>when</div></div>
              {experience.map((item) => <div class="terminal-table__row"><div class="terminal-table__accent">{item.where}</div><div>{item.what}</div><div>{item.when}</div></div>)}
            </div>
          )}
          {step.kind === 'projects' && (
            <div class="terminal-table">
              <div class="terminal-table__head"><div>name</div><div>what it does</div><div>status</div></div>
              {projects.map((item) => <div class="terminal-table__row"><div class="terminal-table__accent">{item.name}</div><div>{item.what}</div><div>{item.status}</div></div>)}
            </div>
          )}
          {step.kind === 'stack' && (
            <div class="terminal-table">
              <div class="terminal-table__head"><div>area</div><div>tools</div><div></div></div>
              {stack.map((item) => <div class="terminal-table__row"><div class="terminal-table__accent">{item.area}</div><div>{item.tools}</div><div></div></div>)}
            </div>
          )}
          {step.kind === 'links' && (
            <div class="terminal-links">
              {profile.links.map((link) => <div><span>{link.label}</span><a href={link.href}>{link.value}</a></div>)}
            </div>
          )}
        </div>
        {step.footer && <div class="terminal-result__footer">{step.footer}</div>}
      </section>
    ))}
  </div>
</section>
